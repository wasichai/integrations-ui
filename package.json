{
    "name": "integrations-ui",
    "private": true,
    "version": "0.2.0",
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "prepare": "husky",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "yarn workspaces run lint",
        "test": "yarn workspaces run test",
        "test:tooling": "node --test tooling/*.test.mjs",
        "build": "node tooling/run-ordered.mjs build"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "husky": "9.1.7",
        "prettier": "3.9.10",
        "typescript": "7.0.2"
    }
}
