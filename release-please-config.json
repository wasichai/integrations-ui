{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "include-component-in-tag": false,
    "packages": {
        ".": {
            "release-type": "node",
            "package-name": "integrations-ui",
            "changelog-path": "CHANGELOG.md",
            "bump-minor-pre-major": true,
            "extra-files": [
                { "type": "json", "path": "packages/integration-sync/package.json", "jsonpath": "$.version" },
                { "type": "json", "path": "packages/integration-workflows/package.json", "jsonpath": "$.version" },
                { "type": "json", "path": "packages/integrations/package.json", "jsonpath": "$.version" }
            ]
        }
    }
}
